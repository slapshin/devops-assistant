# Copy to config.env (never commit it). The Makefile exports it; the backend and
# tools/compose/compose.yml read it too. See docs/DECISIONS.md §2.

# Metrics sources are configured per project in the UI (stored encrypted, see SECRET_KEY).
# METRICS_URL / METRICS_BEARER_TOKEN / METRICS_BASIC_AUTH_* / METRICS_TLS_VERIFY are
# deprecated: they are read once, to give projects migrated from older reports a source.

# Seed one synthetic demo project per scenario when no project exists (make demo sets it).
# DEMO_PROJECTS=false

# openai, none, or fake (offline template for demos/tests). Numerical analysis works without AI.
AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=          # required; any model with Responses API Structured Outputs.
#                        # Verify: cd backend && uv run python -m scripts.check_openai --structured
# OPENAI_BASE_URL=

# Email scheduled reports (configured per project schedule). Off until SMTP_HOST and SMTP_FROM
# are set. In Docker, a relay on the host is host.docker.internal. See docs/OPERATIONS.md.
# EMAIL_PROVIDER=smtp    # smtp, fake (writes DATA_DIR/outbox/*.eml), or none
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls # starttls, tls (implicit, port 465), or none (trusted relay only)
# SMTP_TLS_VERIFY=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=             # e.g. devops-assistant@example.com
# APP_PUBLIC_URL=        # e.g. https://assistant.example.com; emails link to reports

# Native only; Docker always uses 0.0.0.0:8000 and /data inside the container.
# APP_PORT also sets the published host port for Docker.
# DATA_DIR=./data
# APP_HOST=127.0.0.1
# APP_PORT=8000
# SECRET_KEY=           # encrypts stored project credentials; default: generated DATA_DIR/secret.key
# DETECTOR_CONFIG_FILE=  # JSON overrides, see docs/OPERATIONS.md
# UI_STATIC_DIR=         # built UI; defaults to ../frontend/dist when present
LOG_LEVEL=INFO
