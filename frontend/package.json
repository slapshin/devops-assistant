{
  "name": "devops-ai-assistant-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../docs/contracts/openapi.json -o src/api/schema.d.ts",
    "check:api": "node scripts/check-api-types.mjs",
    "check": "npm run check:api && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/vue-query": "5.104.0",
    "echarts": "6.1.0",
    "vue": "3.5.43",
    "vue-echarts": "8.3.1",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
