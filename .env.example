# Copy to backend/.env (never commit .env). See docs/DECISIONS.md §2.
METRICS_URL=http://localhost:8428
# METRICS_BEARER_TOKEN=
# METRICS_BASIC_AUTH_USER=
# METRICS_BASIC_AUTH_PASSWORD=
# METRICS_TLS_VERIFY=true

# openai or none. Numerical analysis works without AI.
AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=          # required for explanations; T006 documents a verified value
# OPENAI_BASE_URL=

DATA_DIR=./data
APP_HOST=127.0.0.1
APP_PORT=8000
# DETECTOR_CONFIG=
LOG_LEVEL=INFO
