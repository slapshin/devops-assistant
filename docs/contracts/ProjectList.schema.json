{
  "$defs": {
    "AnalysisJob": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "title": "Analysis Id",
          "type": "string"
        },
        "config_hash": {
          "title": "Config Hash",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "daily_episodes": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Anomaly episodes per trend day, oldest first; null for days without enough data. Present once a report is saved.",
          "title": "Daily Episodes"
        },
        "detector_version": {
          "title": "Detector Version",
          "type": "string"
        },
        "end_time": {
          "title": "End Time",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explanation_status": {
          "$ref": "#/$defs/ExplanationStatus"
        },
        "finding_counts": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "propertyNames": {
                "$ref": "#/$defs/Severity"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present once a report is saved.",
          "title": "Finding Counts"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "report_available": {
          "title": "Report Available",
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StageProgress"
          },
          "title": "Stages",
          "type": "array"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "trigger": {
          "$ref": "#/$defs/JobTrigger",
          "default": "manual",
          "description": "Submitted by a user or by the project schedule."
        }
      },
      "required": [
        "analysis_id",
        "scope",
        "end_time",
        "detector_version",
        "config_hash",
        "state",
        "stages",
        "explanation_status",
        "created_at",
        "report_available"
      ],
      "title": "AnalysisJob",
      "type": "object"
    },
    "BasicAuth": {
      "additionalProperties": false,
      "properties": {
        "password_set": {
          "title": "Password Set",
          "type": "boolean"
        },
        "type": {
          "const": "basic",
          "default": "basic",
          "title": "Type",
          "type": "string"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "password_set"
      ],
      "title": "BasicAuth",
      "type": "object"
    },
    "BearerAuth": {
      "additionalProperties": false,
      "properties": {
        "token_set": {
          "title": "Token Set",
          "type": "boolean"
        },
        "type": {
          "const": "bearer",
          "default": "bearer",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "token_set"
      ],
      "title": "BearerAuth",
      "type": "object"
    },
    "CloudflareSource": {
      "additionalProperties": false,
      "properties": {
        "api_url": {
          "title": "Api Url",
          "type": "string"
        },
        "hostnames": {
          "items": {
            "type": "string"
          },
          "title": "Hostnames",
          "type": "array"
        },
        "kind": {
          "const": "cloudflare",
          "default": "cloudflare",
          "title": "Kind",
          "type": "string"
        },
        "token_set": {
          "title": "Token Set",
          "type": "boolean"
        },
        "zone_id": {
          "title": "Zone Id",
          "type": "string"
        }
      },
      "required": [
        "zone_id",
        "hostnames",
        "api_url",
        "token_set"
      ],
      "title": "CloudflareSource",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "validation_error",
        "project_not_found",
        "project_name_taken",
        "project_busy",
        "source_not_configured",
        "credentials_unreadable",
        "analysis_not_found",
        "report_not_ready",
        "report_unavailable",
        "schema_unsupported",
        "analysis_not_active",
        "queue_full",
        "metrics_source_unavailable",
        "end_time_invalid",
        "interrupted_by_restart",
        "job_timeout",
        "internal_error",
        "not_implemented"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ExplanationStatus": {
      "enum": [
        "disabled",
        "not_configured",
        "pending",
        "succeeded",
        "failed",
        "skipped_no_findings"
      ],
      "title": "ExplanationStatus",
      "type": "string"
    },
    "JobError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "JobError",
      "type": "object"
    },
    "JobState": {
      "enum": [
        "queued",
        "running",
        "completed",
        "partial",
        "failed",
        "cancelled"
      ],
      "title": "JobState",
      "type": "string"
    },
    "JobTrigger": {
      "enum": [
        "manual",
        "scheduled"
      ],
      "title": "JobTrigger",
      "type": "string"
    },
    "LabelMatcher": {
      "additionalProperties": false,
      "description": "Exact ``name=\"value\"`` matcher added to every selector of a project's queries.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "LabelMatcher",
      "type": "object"
    },
    "NoAuth": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "none",
          "default": "none",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "NoAuth",
      "type": "object"
    },
    "ProjectSummary": {
      "additionalProperties": false,
      "description": "A project with its analysis activity (list and detail pages).",
      "properties": {
        "active_analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisJob"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Queued or running job."
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "credentials_readable": {
          "default": true,
          "description": "False when stored secrets cannot be decrypted (lost or changed key).",
          "title": "Credentials Readable",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "keep_reports": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Newest reports kept; null keeps all.",
          "title": "Keep Reports"
        },
        "latest_analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisJob"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Newest finished job."
        },
        "matchers": {
          "items": {
            "$ref": "#/$defs/LabelMatcher"
          },
          "title": "Matchers",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "next_scheduled_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Next automatic analysis; null without a schedule.",
          "title": "Next Scheduled Run"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "report_count": {
          "default": 0,
          "description": "Saved reports (deleted with it).",
          "minimum": 0,
          "title": "Report Count",
          "type": "integer"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportSchedule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sources": {
          "items": {
            "discriminator": {
              "mapping": {
                "cloudflare": "#/$defs/CloudflareSource",
                "prometheus": "#/$defs/PrometheusSource"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/PrometheusSource"
              },
              {
                "$ref": "#/$defs/CloudflareSource"
              }
            ]
          },
          "title": "Sources",
          "type": "array"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "name",
        "matchers",
        "sources",
        "created_at",
        "updated_at"
      ],
      "title": "ProjectSummary",
      "type": "object"
    },
    "PrometheusSource": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "discriminator": {
            "mapping": {
              "basic": "#/$defs/BasicAuth",
              "bearer": "#/$defs/BearerAuth",
              "none": "#/$defs/NoAuth"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NoAuth"
            },
            {
              "$ref": "#/$defs/BearerAuth"
            },
            {
              "$ref": "#/$defs/BasicAuth"
            }
          ],
          "title": "Auth"
        },
        "kind": {
          "const": "prometheus",
          "default": "prometheus",
          "title": "Kind",
          "type": "string"
        },
        "tls_verify": {
          "title": "Tls Verify",
          "type": "boolean"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "tls_verify",
        "auth"
      ],
      "title": "PrometheusSource",
      "type": "object"
    },
    "ReportSchedule": {
      "additionalProperties": false,
      "description": "Run an analysis automatically at ``time`` (local to ``timezone``) on ``weekdays``.\n\nEach run analyses the 24 h ending at the scheduled instant.",
      "properties": {
        "time": {
          "description": "Local time of day, HH:MM (24 h).",
          "examples": [
            "08:00"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Time",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "description": "IANA time zone, e.g. Europe/Berlin.",
          "maxLength": 64,
          "title": "Timezone",
          "type": "string"
        },
        "weekdays": {
          "description": "Days to run on; all days by default.",
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Weekdays",
          "type": "array"
        }
      },
      "required": [
        "time"
      ],
      "title": "ReportSchedule",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "One project: every Prometheus query carries all of its matchers; reports stay inside it.\n\n``matchers`` is empty only for projects without a Prometheus source; Prometheus queries\nrefuse an empty scope.",
      "properties": {
        "matchers": {
          "items": {
            "$ref": "#/$defs/LabelMatcher"
          },
          "maxItems": 10,
          "title": "Matchers",
          "type": "array"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "project_name": {
          "title": "Project Name",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "project_name",
        "matchers"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StageName": {
      "enum": [
        "discovery",
        "collection",
        "detection",
        "trends",
        "explanation",
        "saving"
      ],
      "title": "StageName",
      "type": "string"
    },
    "StageProgress": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Done"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "stage": {
          "$ref": "#/$defs/StageName"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/StageStatus"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "StageProgress",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "pending",
        "running",
        "done",
        "failed",
        "skipped"
      ],
      "title": "StageStatus",
      "type": "string"
    },
    "Weekday": {
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "title": "Weekday",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ProjectSummary"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "ProjectList",
  "type": "object"
}
