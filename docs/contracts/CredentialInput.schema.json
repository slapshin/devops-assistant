{
  "$defs": {
    "BasicAuthInput": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to keep the stored password (update only).",
          "title": "Password"
        },
        "type": {
          "const": "basic",
          "default": "basic",
          "title": "Type",
          "type": "string"
        },
        "username": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username"
      ],
      "title": "BasicAuthInput",
      "type": "object"
    },
    "BearerAuthInput": {
      "additionalProperties": false,
      "description": "``Authorization: Bearer <token>``.",
      "properties": {
        "token": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to keep the stored token (update only).",
          "title": "Token"
        },
        "type": {
          "const": "bearer",
          "default": "bearer",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "BearerAuthInput",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "prometheus",
        "cloudflare",
        "sentry",
        "wazuh",
        "grafana"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "TokenAuthInput": {
      "additionalProperties": false,
      "description": "The kind's API token: Cloudflare API token, Sentry auth token, Grafana service account\ntoken.",
      "properties": {
        "token": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to keep the stored token (update only).",
          "title": "Token"
        },
        "type": {
          "const": "token",
          "default": "token",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "TokenAuthInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Body of POST /api/credentials and PUT /api/credentials/{credential_id}.",
  "properties": {
    "auth": {
      "description": "Prometheus: bearer or basic; Wazuh: basic; Cloudflare, Sentry and Grafana: token. Omit the secret on update to keep the stored one.",
      "discriminator": {
        "mapping": {
          "basic": "#/$defs/BasicAuthInput",
          "bearer": "#/$defs/BearerAuthInput",
          "token": "#/$defs/TokenAuthInput"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BearerAuthInput"
        },
        {
          "$ref": "#/$defs/BasicAuthInput"
        },
        {
          "$ref": "#/$defs/TokenAuthInput"
        }
      ],
      "title": "Auth"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "kind": {
      "$ref": "#/$defs/SourceKind",
      "description": "Only sources of this kind can use the credential."
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    }
  },
  "required": [
    "name",
    "kind",
    "auth"
  ],
  "title": "CredentialInput",
  "type": "object"
}
