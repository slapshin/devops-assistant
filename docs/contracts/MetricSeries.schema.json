{
  "$defs": {
    "ActiveInterval": {
      "additionalProperties": false,
      "description": "A time range in which an alert instance was active.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null while still active at the analysis end.",
          "title": "End"
        },
        "start": {
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "ActiveInterval",
      "type": "object"
    },
    "AlertInstanceActivity": {
      "additionalProperties": false,
      "description": "One alert instance active in the latest 24 h (Grafana): who it is and when it was active.",
      "properties": {
        "active": {
          "items": {
            "$ref": "#/$defs/ActiveInterval"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Active",
          "type": "array"
        },
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Rendered annotations (summary, description...) when Grafana still lists the instance; otherwise the rule's annotations that hold no template.",
          "title": "Annotations",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Every label of the instance, e.g. instance=host-1.",
          "title": "Labels",
          "type": "object"
        }
      },
      "required": [
        "labels",
        "active"
      ],
      "title": "AlertInstanceActivity",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "description": "Resource identity built from actual labels only; never inferred across namespaces.",
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "key": {
          "description": "Stable canonical key, e.g. 'node|job=node|instance=shop-production'.",
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Identity labels only (no scope matchers).",
          "title": "Labels",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "key",
        "display_name",
        "labels"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityKind": {
      "enum": [
        "node",
        "filesystem",
        "disk",
        "network_interface",
        "container",
        "service",
        "route",
        "proxy",
        "upstream",
        "database",
        "zone",
        "application",
        "agent",
        "alert_rule",
        "custom"
      ],
      "title": "EntityKind",
      "type": "string"
    },
    "SignalFamily": {
      "enum": [
        "cpu",
        "memory",
        "filesystem",
        "disk_io",
        "network",
        "container",
        "request_traffic",
        "request_failures",
        "client_errors",
        "latency",
        "proxy",
        "database",
        "edge",
        "security",
        "app_errors",
        "app_performance",
        "host_security",
        "file_integrity",
        "alerting",
        "custom"
      ],
      "title": "SignalFamily",
      "type": "string"
    },
    "Unit": {
      "enum": [
        "ratio",
        "bytes",
        "bytes_per_second",
        "requests_per_second",
        "per_second",
        "seconds",
        "count"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One scoped series on a regular grid: values[i] is at start + i * step_seconds.\n\n`None` is a gap (no sample), never zero.",
  "properties": {
    "alert_instances": {
      "description": "Alert instances counted in the latest 24 h (Grafana only).",
      "items": {
        "$ref": "#/$defs/AlertInstanceActivity"
      },
      "maxItems": 100,
      "title": "Alert Instances",
      "type": "array"
    },
    "coverage": {
      "description": "Share of steps with a sample.",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Coverage",
      "type": "number"
    },
    "entity": {
      "$ref": "#/$defs/Entity"
    },
    "family": {
      "$ref": "#/$defs/SignalFamily"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "All retained labels of the result series.",
      "title": "Labels",
      "type": "object"
    },
    "query": {
      "description": "Exact query sent to the source (PromQL/MetricsQL, GraphQL).",
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "sample_interval": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Mean sampling interval of the source data (1 = every event counted; Cloudflare adaptive sampling). Null when the source does not sample.",
      "title": "Sample Interval"
    },
    "series_id": {
      "pattern": "^ser_[0-9a-f]{16}$",
      "title": "Series Id",
      "type": "string"
    },
    "signal": {
      "description": "Derived signal, e.g. 'cpu_utilization'.",
      "minLength": 1,
      "title": "Signal",
      "type": "string"
    },
    "start": {
      "title": "Start",
      "type": "string"
    },
    "step_seconds": {
      "exclusiveMinimum": 0,
      "title": "Step Seconds",
      "type": "integer"
    },
    "unit": {
      "$ref": "#/$defs/Unit"
    },
    "values": {
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "series_id",
    "family",
    "signal",
    "entity",
    "labels",
    "unit",
    "query",
    "step_seconds",
    "start",
    "values",
    "coverage"
  ],
  "title": "MetricSeries",
  "type": "object"
}
