{
  "$defs": {
    "AnalysisWindows": {
      "additionalProperties": false,
      "properties": {
        "end_time": {
          "title": "End Time",
          "type": "string"
        },
        "latest_day": {
          "$ref": "#/$defs/TimeRange"
        },
        "step_seconds": {
          "title": "Step Seconds",
          "type": "integer"
        },
        "trend": {
          "$ref": "#/$defs/TimeRange"
        }
      },
      "required": [
        "end_time",
        "latest_day",
        "trend",
        "step_seconds"
      ],
      "title": "AnalysisWindows",
      "type": "object"
    },
    "BaselineMode": {
      "enum": [
        "whole_baseline",
        "time_of_day"
      ],
      "title": "BaselineMode",
      "type": "string"
    },
    "CapabilityStatus": {
      "enum": [
        "supported",
        "partial",
        "unsupported",
        "unverified"
      ],
      "title": "CapabilityStatus",
      "type": "string"
    },
    "ConfidenceLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "DailyTrend": {
      "additionalProperties": false,
      "description": "One 24-hour bucket; bucket_index 0 is the latest day [T-24h, T).",
      "properties": {
        "affected_entities": {
          "description": "Entity keys.",
          "items": {
            "type": "string"
          },
          "title": "Affected Entities",
          "type": "array"
        },
        "anomalous_minutes": {
          "minimum": 0,
          "title": "Anomalous Minutes",
          "type": "integer"
        },
        "anomalous_share": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when nothing was observed.",
          "title": "Anomalous Share"
        },
        "baseline_days_used": {
          "maximum": 14,
          "minimum": 0,
          "title": "Baseline Days Used",
          "type": "integer"
        },
        "bucket_index": {
          "maximum": 13,
          "minimum": 0,
          "title": "Bucket Index",
          "type": "integer"
        },
        "coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage",
          "type": "number"
        },
        "episode_count": {
          "minimum": 0,
          "title": "Episode Count",
          "type": "integer"
        },
        "episodes": {
          "items": {
            "$ref": "#/$defs/EpisodeSummary"
          },
          "title": "Episodes",
          "type": "array"
        },
        "observed_entity_minutes": {
          "description": "Eligible denominator.",
          "minimum": 0,
          "title": "Observed Entity Minutes",
          "type": "integer"
        },
        "peak_severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/TrendBucketStatus"
        },
        "window": {
          "$ref": "#/$defs/TimeRange"
        }
      },
      "required": [
        "bucket_index",
        "window",
        "status",
        "episode_count",
        "anomalous_minutes",
        "peak_severity",
        "affected_entities",
        "observed_entity_minutes",
        "anomalous_share",
        "baseline_days_used",
        "coverage",
        "episodes"
      ],
      "title": "DailyTrend",
      "type": "object"
    },
    "DetectionMethod": {
      "enum": [
        "relative",
        "absolute"
      ],
      "title": "DetectionMethod",
      "type": "string"
    },
    "Entity": {
      "additionalProperties": false,
      "description": "Resource identity built from actual labels only; never inferred across namespaces.",
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "key": {
          "description": "Stable canonical key, e.g. 'node|job=node|instance=shop-production'.",
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Identity labels only (no scope matchers).",
          "title": "Labels",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "key",
        "display_name",
        "labels"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityKind": {
      "enum": [
        "node",
        "filesystem",
        "disk",
        "network_interface",
        "container",
        "service",
        "route",
        "proxy",
        "upstream",
        "database",
        "zone",
        "application"
      ],
      "title": "EntityKind",
      "type": "string"
    },
    "EpisodeSummary": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "title": "End",
          "type": "string"
        },
        "entity": {
          "$ref": "#/$defs/Entity"
        },
        "episode_id": {
          "pattern": "^eps_[0-9a-f]{16}$",
          "title": "Episode Id",
          "type": "string"
        },
        "expected_median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Median"
        },
        "family": {
          "$ref": "#/$defs/SignalFamily"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set only for latest-day episodes with evidence.",
          "title": "Finding Id"
        },
        "peak_observed": {
          "title": "Peak Observed",
          "type": "number"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "signal": {
          "title": "Signal",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "episode_id",
        "finding_id",
        "entity",
        "family",
        "signal",
        "start",
        "end",
        "severity",
        "peak_observed",
        "expected_median",
        "unit"
      ],
      "title": "EpisodeSummary",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Chart data for a finding, persisted so a report reopens without the source.",
      "properties": {
        "evidence_id": {
          "pattern": "^evd_[0-9a-f]{16}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "series": {
          "$ref": "#/$defs/MetricSeries"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "threshold_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Label"
        },
        "upper": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "required": [
        "evidence_id",
        "finding_id",
        "series"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
      "description": "Something omitted from the report, always disclosed (codes in docs/contracts.md).",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "family": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignalFamily"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "ExpectedValue": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "median": {
          "title": "Median",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "median",
        "lower",
        "upper",
        "unit"
      ],
      "title": "ExpectedValue",
      "type": "object"
    },
    "Explanation": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "investigation_steps": {
          "items": {
            "$ref": "#/$defs/InvestigationStep"
          },
          "title": "Investigation Steps",
          "type": "array"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "uncertainty": {
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "hypotheses",
        "investigation_steps",
        "uncertainty",
        "provider",
        "model",
        "generated_at"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "ExplanationResult": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Explanation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why failed/not_configured/disabled.",
          "title": "Reason"
        },
        "status": {
          "$ref": "#/$defs/ExplanationStatus"
        },
        "validation_notes": {
          "description": "E.g. dropped items referencing unknown finding IDs.",
          "items": {
            "type": "string"
          },
          "title": "Validation Notes",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "ExplanationResult",
      "type": "object"
    },
    "ExplanationStatus": {
      "enum": [
        "disabled",
        "not_configured",
        "pending",
        "succeeded",
        "failed",
        "skipped_no_findings"
      ],
      "title": "ExplanationStatus",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Descriptive labels, e.g. error_type; not identity.",
          "title": "Attributes",
          "type": "object"
        },
        "baseline_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Days"
        },
        "baseline_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "confidence_reasons": {
          "description": "Every factor that lowered confidence; empty when high.",
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Confidence Reasons",
          "type": "array"
        },
        "detector": {
          "title": "Detector",
          "type": "string"
        },
        "detector_version": {
          "title": "Detector Version",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "string"
        },
        "entity": {
          "$ref": "#/$defs/Entity"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpectedValue"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for absolute-only findings."
        },
        "family": {
          "$ref": "#/$defs/SignalFamily"
        },
        "finding_id": {
          "pattern": "^fnd_[0-9a-f]{16}$",
          "title": "Finding Id",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/DetectionMethod"
        },
        "observed": {
          "$ref": "#/$defs/ObservedValue",
          "description": "Peak observed value in the episode."
        },
        "peak_at": {
          "title": "Peak At",
          "type": "string"
        },
        "peak_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Robust z-score; null for absolute checks.",
          "title": "Peak Score"
        },
        "prior_episode_days": {
          "default": 0,
          "maximum": 13,
          "minimum": 0,
          "title": "Prior Episode Days",
          "type": "integer"
        },
        "recurrence": {
          "$ref": "#/$defs/Recurrence",
          "default": "new"
        },
        "related_finding_ids": {
          "description": "Findings sharing identity labels only.",
          "items": {
            "type": "string"
          },
          "title": "Related Finding Ids",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "severity_points": {
          "minimum": 0,
          "title": "Severity Points",
          "type": "integer"
        },
        "signal": {
          "title": "Signal",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/FindingState",
          "default": "resolved"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Heuristic threshold for absolute checks.",
          "title": "Threshold"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "detector",
        "detector_version",
        "method",
        "family",
        "signal",
        "title",
        "entity",
        "start",
        "end",
        "peak_at",
        "duration_seconds",
        "severity",
        "severity_points",
        "confidence",
        "confidence_reasons",
        "observed",
        "expected",
        "peak_score",
        "threshold",
        "baseline_days",
        "baseline_mode",
        "evidence_ids"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingState": {
      "enum": [
        "ongoing",
        "resolved"
      ],
      "title": "FindingState",
      "type": "string"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "description": "Always presented as unverified.",
      "properties": {
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Ids",
          "type": "array"
        },
        "likelihood": {
          "$ref": "#/$defs/Likelihood"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "finding_ids",
        "likelihood"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "InvestigationStep": {
      "additionalProperties": false,
      "properties": {
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "InvestigationStep",
      "type": "object"
    },
    "LabelMatcher": {
      "additionalProperties": false,
      "description": "Exact ``name=\"value\"`` matcher added to every selector of a project's queries.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "LabelMatcher",
      "type": "object"
    },
    "Likelihood": {
      "enum": [
        "plausible",
        "possible",
        "speculative"
      ],
      "title": "Likelihood",
      "type": "string"
    },
    "MetricCapability": {
      "additionalProperties": false,
      "description": "Whether a signal family can be analysed for a scope, and why (not).",
      "properties": {
        "family": {
          "$ref": "#/$defs/SignalFamily"
        },
        "history_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Observed history for the scope; not proof of retention.",
          "title": "History Days"
        },
        "observed_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Observed Metrics",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "required_labels": {
          "items": {
            "type": "string"
          },
          "title": "Required Labels",
          "type": "array"
        },
        "required_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Required Metrics",
          "type": "array"
        },
        "signal": {
          "title": "Signal",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceKind",
          "default": "prometheus"
        },
        "status": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "verified": {
          "description": "True only when observed in the live source.",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "family",
        "signal",
        "status",
        "verified",
        "required_metrics",
        "required_labels"
      ],
      "title": "MetricCapability",
      "type": "object"
    },
    "MetricSeries": {
      "additionalProperties": false,
      "description": "One scoped series on a regular grid: values[i] is at start + i * step_seconds.\n\n`None` is a gap (no sample), never zero.",
      "properties": {
        "coverage": {
          "description": "Share of steps with a sample.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage",
          "type": "number"
        },
        "entity": {
          "$ref": "#/$defs/Entity"
        },
        "family": {
          "$ref": "#/$defs/SignalFamily"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "All retained labels of the result series.",
          "title": "Labels",
          "type": "object"
        },
        "query": {
          "description": "Exact query sent to the source (PromQL/MetricsQL, GraphQL).",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "sample_interval": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean sampling interval of the source data (1 = every event counted; Cloudflare adaptive sampling). Null when the source does not sample.",
          "title": "Sample Interval"
        },
        "series_id": {
          "pattern": "^ser_[0-9a-f]{16}$",
          "title": "Series Id",
          "type": "string"
        },
        "signal": {
          "description": "Derived signal, e.g. 'cpu_utilization'.",
          "minLength": 1,
          "title": "Signal",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "step_seconds": {
          "exclusiveMinimum": 0,
          "title": "Step Seconds",
          "type": "integer"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "series_id",
        "family",
        "signal",
        "entity",
        "labels",
        "unit",
        "query",
        "step_seconds",
        "start",
        "values",
        "coverage"
      ],
      "title": "MetricSeries",
      "type": "object"
    },
    "ObservedValue": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
