{
  "$defs": {
    "BasicAuthInput": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to keep the stored password (update only).",
          "title": "Password"
        },
        "type": {
          "const": "basic",
          "default": "basic",
          "title": "Type",
          "type": "string"
        },
        "username": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username"
      ],
      "title": "BasicAuthInput",
      "type": "object"
    },
    "BearerAuthInput": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to keep the stored token (update only).",
          "title": "Token"
        },
        "type": {
          "const": "bearer",
          "default": "bearer",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "BearerAuthInput",
      "type": "object"
    },
    "LabelMatcher": {
      "additionalProperties": false,
      "description": "Exact ``name=\"value\"`` matcher added to every selector of the project's queries.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "LabelMatcher",
      "type": "object"
    },
    "NoAuth": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "none",
          "default": "none",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "NoAuth",
      "type": "object"
    },
    "PrometheusSourceInput": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "discriminator": {
            "mapping": {
              "basic": "#/$defs/BasicAuthInput",
              "bearer": "#/$defs/BearerAuthInput",
              "none": "#/$defs/NoAuth"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NoAuth"
            },
            {
              "$ref": "#/$defs/BearerAuthInput"
            },
            {
              "$ref": "#/$defs/BasicAuthInput"
            }
          ],
          "title": "Auth"
        },
        "kind": {
          "const": "prometheus",
          "default": "prometheus",
          "title": "Kind",
          "type": "string"
        },
        "tls_verify": {
          "default": true,
          "title": "Tls Verify",
          "type": "boolean"
        },
        "url": {
          "maxLength": 2048,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "PrometheusSourceInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Body of POST /api/projects/test-connection: a draft, possibly reusing stored secrets.",
  "properties": {
    "matchers": {
      "items": {
        "$ref": "#/$defs/LabelMatcher"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Matchers",
      "type": "array"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reuse this project's stored secrets for omitted ones.",
      "title": "Project Id"
    },
    "source": {
      "$ref": "#/$defs/PrometheusSourceInput"
    }
  },
  "required": [
    "matchers",
    "source"
  ],
  "title": "ConnectionTestRequest",
  "type": "object"
}
