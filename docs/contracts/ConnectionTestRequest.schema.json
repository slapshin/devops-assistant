{
  "$defs": {
    "BasicAuthInput": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to keep the stored password (update only).",
          "title": "Password"
        },
        "type": {
          "const": "basic",
          "default": "basic",
          "title": "Type",
          "type": "string"
        },
        "username": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username"
      ],
      "title": "BasicAuthInput",
      "type": "object"
    },
    "BearerAuthInput": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to keep the stored token (update only).",
          "title": "Token"
        },
        "type": {
          "const": "bearer",
          "default": "bearer",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "BearerAuthInput",
      "type": "object"
    },
    "CloudflareSourceInput": {
      "additionalProperties": false,
      "description": "One Cloudflare zone, optionally narrowed to some of its hostnames.",
      "properties": {
        "api_token": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "API token with Analytics:Read on the zone (and optionally Zone:Read, to show its domain). Omit to keep the stored one (update only); not needed for synthetic://.",
          "title": "Api Token"
        },
        "api_url": {
          "default": "https://api.cloudflare.com/client/v4/graphql",
          "description": "GraphQL endpoint; synthetic://<scenario> for demo data.",
          "maxLength": 2048,
          "title": "Api Url",
          "type": "string"
        },
        "hostnames": {
          "description": "Analyse only these hostnames; empty analyses the whole zone.",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Hostnames",
          "type": "array"
        },
        "kind": {
          "const": "cloudflare",
          "default": "cloudflare",
          "title": "Kind",
          "type": "string"
        },
        "zone_id": {
          "description": "Zone ID (32 hex characters, dashboard → Overview).",
          "title": "Zone Id",
          "type": "string"
        }
      },
      "required": [
        "zone_id"
      ],
      "title": "CloudflareSourceInput",
      "type": "object"
    },
    "LabelMatcher": {
      "additionalProperties": false,
      "description": "Exact ``name=\"value\"`` matcher added to every selector of a project's queries.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "LabelMatcher",
      "type": "object"
    },
    "NoAuth": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "none",
          "default": "none",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "NoAuth",
      "type": "object"
    },
    "PrometheusSourceInput": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "discriminator": {
            "mapping": {
              "basic": "#/$defs/BasicAuthInput",
              "bearer": "#/$defs/BearerAuthInput",
              "none": "#/$defs/NoAuth"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NoAuth"
            },
            {
              "$ref": "#/$defs/BearerAuthInput"
            },
            {
              "$ref": "#/$defs/BasicAuthInput"
            }
          ],
          "title": "Auth"
        },
        "kind": {
          "const": "prometheus",
          "default": "prometheus",
          "title": "Kind",
          "type": "string"
        },
        "tls_verify": {
          "default": true,
          "title": "Tls Verify",
          "type": "boolean"
        },
        "url": {
          "maxLength": 2048,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "PrometheusSourceInput",
      "type": "object"
    },
    "SentrySourceInput": {
      "additionalProperties": false,
      "description": "Sentry projects of one organization, optionally narrowed to an environment and tags.",
      "properties": {
        "api_url": {
          "default": "https://sentry.io",
          "description": "Sentry base URL: https://sentry.io, https://de.sentry.io for EU organizations, or a self-hosted instance (path prefixes are kept); synthetic://<scenario> for demo data.",
          "maxLength": 2048,
          "title": "Api Url",
          "type": "string"
        },
        "auth_token": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Auth token with org:read and project:read. Omit to keep the stored one (update only); not needed for synthetic://.",
          "title": "Auth Token"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Analyse only this environment; null analyses all of them.",
          "title": "Environment"
        },
        "kind": {
          "const": "sentry",
          "default": "sentry",
          "title": "Kind",
          "type": "string"
        },
        "organization": {
          "description": "Organization slug (Settings → General).",
          "title": "Organization",
          "type": "string"
        },
        "projects": {
          "description": "Project slugs (Settings → Projects); each is analysed as its own entity.",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Projects",
          "type": "array"
        },
        "tags": {
          "description": "Tag filters applied to every project, all of which must match.",
          "items": {
            "$ref": "#/$defs/SentryTag"
          },
          "maxItems": 10,
          "title": "Tags",
          "type": "array"
        },
        "tls_verify": {
          "default": true,
          "description": "Verify the server's TLS certificate; turn off only for a self-hosted Sentry with a self-signed or internal certificate.",
          "title": "Tls Verify",
          "type": "boolean"
        }
      },
      "required": [
        "organization",
        "projects"
      ],
      "title": "SentrySourceInput",
      "type": "object"
    },
    "SentryTag": {
      "additionalProperties": false,
      "description": "Exact ``key:\"value\"`` tag filter added to every Sentry query of the source.",
      "properties": {
        "key": {
          "description": "Tag key, e.g. server_name, release or a custom tag.",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "SentryTag",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Body of POST /api/projects/test-connection: a draft, possibly reusing stored secrets.",
  "properties": {
    "matchers": {
      "description": "Required with a Prometheus source.",
      "items": {
        "$ref": "#/$defs/LabelMatcher"
      },
      "maxItems": 10,
      "title": "Matchers",
      "type": "array"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reuse this project's stored secrets for omitted ones.",
      "title": "Project Id"
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/PrometheusSourceInput"
        },
        {
          "$ref": "#/$defs/CloudflareSourceInput"
        },
        {
          "$ref": "#/$defs/SentrySourceInput"
        }
      ],
      "title": "Source"
    }
  },
  "required": [
    "source"
  ],
  "title": "ConnectionTestRequest",
  "type": "object"
}
