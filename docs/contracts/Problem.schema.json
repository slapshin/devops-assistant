        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Errors"
    },
    "status": {
      "title": "Status",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "type": {
      "default": "about:blank",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "title",
    "status",
    "code"
  ],
  "title": "Problem",
  "type": "object"
}
