{
  "$defs": {
    "AnalysisJob": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "title": "Analysis Id",
          "type": "string"
        },
        "config_hash": {
          "title": "Config Hash",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "detector_version": {
          "title": "Detector Version",
          "type": "string"
        },
        "end_time": {
          "title": "End Time",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explanation_status": {
          "$ref": "#/$defs/ExplanationStatus"
        },
        "finding_counts": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "propertyNames": {
                "$ref": "#/$defs/Severity"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present once a report is saved.",
          "title": "Finding Counts"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "report_available": {
          "title": "Report Available",
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StageProgress"
          },
          "title": "Stages",
          "type": "array"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        }
      },
      "required": [
        "analysis_id",
        "scope",
        "end_time",
        "detector_version",
        "config_hash",
        "state",
        "stages",
        "explanation_status",
        "created_at",
        "report_available"
      ],
      "title": "AnalysisJob",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "validation_error",
        "project_not_found",
        "project_name_taken",
        "credentials_unreadable",
        "env_not_found",
        "analysis_not_found",
        "report_not_ready",
        "report_unavailable",
        "schema_unsupported",
        "analysis_not_active",
        "queue_full",
        "metrics_source_unavailable",
        "end_time_invalid",
        "interrupted_by_restart",
        "job_timeout",
        "internal_error",
        "not_implemented"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ExplanationStatus": {
      "enum": [
        "disabled",
        "not_configured",
        "pending",
        "succeeded",
        "failed",
        "skipped_no_findings"
      ],
      "title": "ExplanationStatus",
      "type": "string"
    },
    "JobError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "JobError",
      "type": "object"
    },
    "JobState": {
      "enum": [
        "queued",
        "running",
        "completed",
        "partial",
        "failed",
        "cancelled"
      ],
      "title": "JobState",
      "type": "string"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Exactly one project/env pair. Every query and report stays inside it.",
      "properties": {
        "env": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Env",
          "type": "string"
        },
        "project": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Project",
          "type": "string"
        }
      },
      "required": [
        "project",
        "env"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StageName": {
      "enum": [
        "discovery",
        "collection",
        "detection",
        "trends",
        "explanation",
        "saving"
      ],
      "title": "StageName",
      "type": "string"
    },
    "StageProgress": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Done"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "stage": {
          "$ref": "#/$defs/StageName"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/StageStatus"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "StageProgress",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "pending",
        "running",
        "done",
        "failed",
        "skipped"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "$ref": "#/$defs/AnalysisJob"
    },
    "duplicate_of_active": {
      "default": false,
      "title": "Duplicate Of Active",
      "type": "boolean"
    }
  },
  "required": [
    "analysis"
  ],
  "title": "AnalysisSubmitted",
  "type": "object"
}
