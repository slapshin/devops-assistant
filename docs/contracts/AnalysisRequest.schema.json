{
  "$defs": {
    "LabelMatcher": {
      "additionalProperties": false,
      "description": "Exact ``name=\"value\"`` matcher added to every selector of a project's queries.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "LabelMatcher",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "One project: every Prometheus query carries all of its matchers; reports stay inside it.\n\n``matchers`` is empty only for projects without a Prometheus source; Prometheus queries\nrefuse an empty scope.",
      "properties": {
        "matchers": {
          "items": {
            "$ref": "#/$defs/LabelMatcher"
          },
          "maxItems": 10,
          "title": "Matchers",
          "type": "array"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "project_name": {
          "title": "Project Name",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "project_name",
        "matchers"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Framework-independent input to AnalysisService. end_time is already frozen and aligned.",
  "properties": {
    "config_hash": {
      "pattern": "^[0-9a-f]{12}$",
      "title": "Config Hash",
      "type": "string"
    },
    "detector_version": {
      "title": "Detector Version",
      "type": "string"
    },
    "end_time": {
      "title": "End Time",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    }
  },
  "required": [
    "scope",
    "end_time",
    "detector_version",
    "config_hash"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
