{
  "$defs": {
    "BasicAuthInput": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to keep the stored password (update only).",
          "title": "Password"
        },
        "type": {
          "const": "basic",
          "default": "basic",
          "title": "Type",
          "type": "string"
        },
        "username": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username"
      ],
      "title": "BasicAuthInput",
      "type": "object"
    },
    "BearerAuthInput": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to keep the stored token (update only).",
          "title": "Token"
        },
        "type": {
          "const": "bearer",
          "default": "bearer",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "BearerAuthInput",
      "type": "object"
    },
    "CloudflareSourceInput": {
      "additionalProperties": false,
      "description": "One Cloudflare zone, optionally narrowed to some of its hostnames.",
      "properties": {
        "api_token": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "API token with Analytics:Read on the zone (and optionally Zone:Read, to show its domain). Omit to keep the stored one (update only); not needed for synthetic://.",
          "title": "Api Token"
        },
        "api_url": {
          "default": "https://api.cloudflare.com/client/v4/graphql",
          "description": "GraphQL endpoint; synthetic://<scenario> for demo data.",
          "maxLength": 2048,
          "title": "Api Url",
          "type": "string"
        },
        "hostnames": {
          "description": "Analyse only these hostnames; empty analyses the whole zone.",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Hostnames",
          "type": "array"
        },
        "kind": {
          "const": "cloudflare",
          "default": "cloudflare",
          "title": "Kind",
          "type": "string"
        },
        "zone_id": {
          "description": "Zone ID (32 hex characters, dashboard → Overview).",
          "title": "Zone Id",
          "type": "string"
        }
      },
      "required": [
        "zone_id"
      ],
      "title": "CloudflareSourceInput",
      "type": "object"
    },
    "LabelMatcher": {
      "additionalProperties": false,
      "description": "Exact ``name=\"value\"`` matcher added to every selector of a project's queries.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "LabelMatcher",
      "type": "object"
    },
    "NoAuth": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "none",
          "default": "none",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "NoAuth",
      "type": "object"
    },
    "PrometheusSourceInput": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "discriminator": {
            "mapping": {
              "basic": "#/$defs/BasicAuthInput",
              "bearer": "#/$defs/BearerAuthInput",
              "none": "#/$defs/NoAuth"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NoAuth"
            },
            {
              "$ref": "#/$defs/BearerAuthInput"
            },
            {
              "$ref": "#/$defs/BasicAuthInput"
            }
          ],
          "title": "Auth"
        },
        "kind": {
          "const": "prometheus",
          "default": "prometheus",
          "title": "Kind",
          "type": "string"
        },
        "tls_verify": {
          "default": true,
          "title": "Tls Verify",
          "type": "boolean"
        },
        "url": {
          "maxLength": 2048,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "PrometheusSourceInput",
      "type": "object"
    },
    "ReportSchedule": {
      "additionalProperties": false,
      "description": "Run an analysis automatically at ``time`` (local to ``timezone``) on ``weekdays``.\n\nEach run analyses the 24 h ending at the scheduled instant.",
      "properties": {
        "time": {
          "description": "Local time of day, HH:MM (24 h).",
          "examples": [
            "08:00"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Time",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "description": "IANA time zone, e.g. Europe/Berlin.",
          "maxLength": 64,
          "title": "Timezone",
          "type": "string"
        },
        "weekdays": {
          "description": "Days to run on; all days by default.",
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Weekdays",
          "type": "array"
        }
      },
      "required": [
        "time"
      ],
      "title": "ReportSchedule",
      "type": "object"
    },
    "SentrySourceInput": {
      "additionalProperties": false,
      "description": "Sentry projects of one organization, optionally narrowed to an environment and tags.",
      "properties": {
        "api_url": {
          "default": "https://sentry.io",
          "description": "Sentry base URL: https://sentry.io, https://de.sentry.io for EU organizations, or a self-hosted instance (path prefixes are kept); synthetic://<scenario> for demo data.",
          "maxLength": 2048,
          "title": "Api Url",
          "type": "string"
        },
        "auth_token": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Auth token with org:read and project:read. Omit to keep the stored one (update only); not needed for synthetic://.",
          "title": "Auth Token"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Analyse only this environment; null analyses all of them.",
          "title": "Environment"
        },
        "kind": {
          "const": "sentry",
          "default": "sentry",
          "title": "Kind",
          "type": "string"
        },
        "organization": {
          "description": "Organization slug (Settings → General).",
          "title": "Organization",
          "type": "string"
        },
        "projects": {
          "description": "Project slugs (Settings → Projects); each is analysed as its own entity.",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Projects",
          "type": "array"
        },
        "tags": {
          "description": "Tag filters applied to every project, all of which must match.",
          "items": {
            "$ref": "#/$defs/SentryTag"
          },
          "maxItems": 10,
          "title": "Tags",
          "type": "array"
        },
        "tls_verify": {
          "default": true,
          "description": "Verify the server's TLS certificate; turn off only for a self-hosted Sentry with a self-signed or internal certificate.",
          "title": "Tls Verify",
          "type": "boolean"
        }
      },
      "required": [
        "organization",
        "projects"
      ],
      "title": "SentrySourceInput",
      "type": "object"
    },
    "SentryTag": {
      "additionalProperties": false,
      "description": "Exact ``key:\"value\"`` tag filter added to every Sentry query of the source.",
      "properties": {
        "key": {
          "description": "Tag key, e.g. server_name, release or a custom tag.",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "SentryTag",
      "type": "object"
    },
    "WazuhLabel": {
      "additionalProperties": false,
      "description": "Exact ``agent.labels.<key> = value`` filter (an agent's ``<labels>`` setting).",
      "properties": {
        "key": {
          "description": "Label key as set in the agent's <labels> block, e.g. project.",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "WazuhLabel",
      "type": "object"
    },
    "WazuhSourceInput": {
      "additionalProperties": false,
      "description": "Wazuh agents selected by name, group and/or agent labels, read from the Wazuh indexer.\n\nThe named agents and the groups' members together form the selection; label filters\nnarrow it (or alone select every agent that has those labels).",
      "properties": {
        "agents": {
          "description": "Agent names (agent.name); each is analysed as its own entity.",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Agents",
          "type": "array"
        },
        "api_url": {
          "description": "Wazuh indexer URL, e.g. https://wazuh-indexer:9200 (path prefixes are kept); synthetic://<scenario> for demo data.",
          "maxLength": 2048,
          "title": "Api Url",
          "type": "string"
        },
        "groups": {
          "description": "Agent groups; their current members (from the monitoring index) are analysed together with the named agents.",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Groups",
          "type": "array"
        },
        "index_pattern": {
          "default": "wazuh-alerts-4.x-*",
          "description": "Alerts index pattern of the indexer.",
          "title": "Index Pattern",
          "type": "string"
        },
        "kind": {
          "const": "wazuh",
          "default": "wazuh",
          "title": "Kind",
          "type": "string"
        },
        "labels": {
          "description": "Agent label filters (agent.labels.<key>), all of which must match.",
          "items": {
            "$ref": "#/$defs/WazuhLabel"
          },
          "maxItems": 10,
          "title": "Labels",
          "type": "array"
        },
        "monitoring_index_pattern": {
          "default": "wazuh-monitoring-*",
          "description": "Index of the agent snapshots the Wazuh dashboard writes; used to resolve groups.",
          "title": "Monitoring Index Pattern",
          "type": "string"
        },
        "password": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to keep the stored password (update only); not needed for synthetic://.",
          "title": "Password"
        },
        "tls_verify": {
          "default": true,
          "description": "Verify the indexer's TLS certificate; turn off only for a self-signed or internal certificate (the Wazuh default).",
          "title": "Tls Verify",
          "type": "boolean"
        },
        "username": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indexer user with read access to the alerts indices; not needed for synthetic://.",
          "title": "Username"
        }
      },
      "required": [
        "api_url"
      ],
      "title": "WazuhSourceInput",
      "type": "object"
    },
    "Weekday": {
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "title": "Weekday",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Body of POST /api/projects and PUT /api/projects/{project_id}.",
  "properties": {
    "description": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "keep_reports": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Keep only this many newest reports; older analyses are deleted automatically. Null keeps all.",
      "title": "Keep Reports"
    },
    "matchers": {
      "description": "Required (1-10) with a Prometheus source.",
      "items": {
        "$ref": "#/$defs/LabelMatcher"
      },
      "maxItems": 10,
      "title": "Matchers",
      "type": "array"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "schedule": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportSchedule"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Automatic analyses; null runs analyses on demand only."
    },
    "sources": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/PrometheusSourceInput"
          },
          {
            "$ref": "#/$defs/CloudflareSourceInput"
          },
          {
            "$ref": "#/$defs/SentrySourceInput"
          },
          {
            "$ref": "#/$defs/WazuhSourceInput"
          }
        ]
      },
      "maxItems": 4,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "name"
  ],
  "title": "ProjectInput",
  "type": "object"
}
