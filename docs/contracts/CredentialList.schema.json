{
  "$defs": {
    "BasicAuth": {
      "additionalProperties": false,
      "properties": {
        "password_set": {
          "title": "Password Set",
          "type": "boolean"
        },
        "type": {
          "const": "basic",
          "default": "basic",
          "title": "Type",
          "type": "string"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "password_set"
      ],
      "title": "BasicAuth",
      "type": "object"
    },
    "BearerAuth": {
      "additionalProperties": false,
      "properties": {
        "token_set": {
          "title": "Token Set",
          "type": "boolean"
        },
        "type": {
          "const": "bearer",
          "default": "bearer",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "token_set"
      ],
      "title": "BearerAuth",
      "type": "object"
    },
    "Credential": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "discriminator": {
            "mapping": {
              "basic": "#/$defs/BasicAuth",
              "bearer": "#/$defs/BearerAuth",
              "token": "#/$defs/TokenAuth"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BearerAuth"
            },
            {
              "$ref": "#/$defs/BasicAuth"
            },
            {
              "$ref": "#/$defs/TokenAuth"
            }
          ],
          "title": "Auth"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "credential_id": {
          "title": "Credential Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "readable": {
          "default": true,
          "description": "False when the stored secret cannot be decrypted (lost or changed key).",
          "title": "Readable",
          "type": "boolean"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "used_by": {
          "description": "Projects whose sources use the credential.",
          "items": {
            "$ref": "#/$defs/CredentialUsage"
          },
          "title": "Used By",
          "type": "array"
        }
      },
      "required": [
        "credential_id",
        "name",
        "kind",
        "auth",
        "created_at",
        "updated_at"
      ],
      "title": "Credential",
      "type": "object"
    },
    "CredentialUsage": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "name"
      ],
      "title": "CredentialUsage",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "prometheus",
        "cloudflare",
        "sentry",
        "wazuh",
        "grafana"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "TokenAuth": {
      "additionalProperties": false,
      "properties": {
        "token_set": {
          "title": "Token Set",
          "type": "boolean"
        },
        "type": {
          "const": "token",
          "default": "token",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "token_set"
      ],
      "title": "TokenAuth",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/Credential"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "CredentialList",
  "type": "object"
}
